// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new ESPHome
// release, plus the "Dependency Dashboard" issue listing what is open. ESPHome is what the energy
// dashboard (main.yml on the Guition ESP32-S3-4848S040) builds on: it brings the ESP-IDF framework,
// the toolchain and every component the YAML uses, so it is pinned to one exact release: the pin in
// requirements.txt (CI's pip install) and the image in docker-compose.yml. They move together in
// one PR, whose build check validates and compiles the config with the new release. No external
// components, git packages or other pins exist here.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  packageRules: [
    {
      // The pip package and the image, in one PR so requirements.txt and docker-compose.yml cannot
      // drift apart. Only releases like 2026.10.1: betas (2026.11.0b1) and the image's nightly
      // tags (2026.11.0-dev20261030) are left out.
      matchPackageNames: ["esphome", "ghcr.io/esphome/esphome"],
      groupName: "ESPHome",
      sourceUrl: "https://github.com/esphome/esphome",
      commitMessageTopic: "ESPHome",
      prBodyNotes: [
        "Before merging: read the [ESPHome changelog](https://esphome.io/changelog/) of every release between the old and the new pin, its **Breaking changes** first (a monthly release `YYYY.M.0` brings them, a patch release `YYYY.M.x` fixes bugs). Look for `lvgl`, `image` (the RGB565 images with alpha from `tools/make_images.py`), `font`, `st7701s`, `gt911`, `esp32` (ESP-IDF version, `sdkconfig_options`, `execute_from_psram`), `host`/`sdl` (the preview) and `homeassistant` sensors. The build check of this PR validates and compiles `main.yml`. Before merging, flash this branch onto the dashboard over Wi-Fi, watch `esphome logs` and check that the energy flow, the battery wave and the page *Heute* follow the Home Assistant sensors. Then merge. After merging, the Screenshots workflow on main renders the scenes with the new release: look at the new pictures in `docs/`. The minimum version in the README badge and table stays unless the config starts to use something newer. If the build fails on a Python requirement of the new release, raise `python-version` in the workflows.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // pip (pep440) already leaves out the betas; the image also has nightly tags, so only
      // YYYY.M.x counts there
      matchPackageNames: ["ghcr.io/esphome/esphome"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
  ],
}
